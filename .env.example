# Default: use the challenge APIs. Never place these values in frontend variables.
AIMO_MODE=live
AIMO_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# For a clearly labeled offline development demo, explicitly set AIMO_MODE=fixture.
# replay requires a recording made with scripts/record-challenge.py.

# Docker: localhost over HTTP. Production: set your public domain, HTTP_PORT=80,
# COOKIE_SECURE=true, and point the domain to your server.
SITE_ADDRESS=http://localhost
HTTP_PORT=8080
HTTPS_PORT=443
COOKIE_SECURE=false

# Optional local Python overrides (Docker sets container paths automatically).
# DATABASE_URL=sqlite:////absolute/path/to/aimo.db
# CATALOG_PATH=/absolute/path/to/catalog.db
# REPLAY_PATH=/absolute/path/to/replay.json
